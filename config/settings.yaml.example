# ==============================================================================
backtest:
  symbols_to_test:
    - "BTC-USDT"
    - "ETH-USDT"
    - "SOL-USDT"
    - "KDA-USDT"
    - "CFX-USDT"
    - "DOT-USDT"

# ==============================================================================
# File System Paths
# ==============================================================================
paths:
  model_dir: "models"
  feature_cache_dir: "data/cache"
  history_data_dir: "data/history"

# ==============================================================================
# Risk Monitoring & Alerting Configuration
# ==============================================================================
risk_monitoring:
  # Risk thresholds for monitoring
  daily_loss_threshold: -500.0    # Maximum daily loss in account currency
  max_drawdown_threshold: 0.10    # Maximum drawdown (10%)
  max_consecutive_losses: 5       # Maximum consecutive losing trades
  max_single_loss_pct: -0.03      # Maximum single trade loss percentage (-3%)
  min_account_balance: 1000.0     # Minimum account balance to maintain

  # Email alerting configuration
  email:
    smtp_server: "smtp.gmail.com"    # SMTP server for sending alerts
    smtp_port: 587                   # SMTP port
    user: "your_email@gmail.com"     # Email account
    password: "your_app_password"    # Email app password (not regular password)
    recipients:                      # List of email addresses to receive alerts
      - "admin@yourcompany.com"
      - "risk@yourcompany.com"

# ==============================================================================
# Strategy Management Configuration
# ==============================================================================
strategy_management:
  # List of enabled strategies
  enabled_strategies:
    - "lgb"        # Main ML strategy
    - "transformer" # Deep Learning Strategy (New)
    - "ma_fast"    # Fast mean reversion strategy
    - "ma_slow"    # Slow trend following strategy
    - "ma_slow"    # Slow trend following strategy
  
  # Strategy-specific configurations
  lgb_strategy:
    model_dir: "models"
    model_name: "best_model.pkl"
    model_name: "best_model.pkl"
    metadata_name: "metadata.json"

  # Transformer Model Config (Add this to your real settings.yaml)
  transformer_strategy:
    enabled: true
    window_size: 60
    input_dim: 108 # Adjust based on your feature set (check scaler.n_features_in_)
    model_path: "models/transformer_v1.pth"
    scaler_path: "models/scaler_v1.pkl"
  
  ma_fast_strategy:
    short_window: 5
    long_window: 15
  
  ma_slow_strategy:
    short_window: 20
    long_window: 50
  
  # Strategy switching parameters
  strategy_switch:
    lookback_days: 7          # Number of days to evaluate strategy performance
    performance_threshold: 0.5 # Minimum Sharpe ratio difference to trigger switch

# ==============================================================================
# News Monitoring Configuration
# ==============================================================================
news_monitoring:
  # Enable/disable news monitoring
  enabled: true
  
  # CryptoPanic API configuration (optional, free version works without API key)
  cryptopanic_api_key: null  # Set to your API key if you have one
  
  # How often to check news (in seconds)
  check_interval: 60  # Check every 60 seconds
  
  # Time window for recent news analysis (in minutes)
  recent_news_window: 5  # Only analyze news from last 5 minutes
  
  # Monitored currencies
  currencies:
    - "BTC"
    - "ETH"
  
  # Action on critical news
  critical_action: "emergency_stop"  # or "reduce_position"
  
  # Action on warning news
  warning_action: "reduce_position"
  
  # Position multiplier when warnings detected
  warning_position_multiplier: 0.5  # Reduce to 50%

# ==============================================================================
# Event Calendar Configuration
# ==============================================================================
event_calendar:
  # Enable/disable event calendar
  enabled: true
  
  # How many days ahead to check for events
  check_days_ahead: 3
  
  # Position multipliers for different impact levels
  position_multipliers:
    CRITICAL: 0.0   # Pause trading
    HIGH: 0.3       # Reduce to 30%
    MEDIUM: 0.5     # Reduce to 50%
    LOW: 1.0        # Normal
  
  # Custom one-time events (add manually as needed)
  custom_events: []
    # Example:
    # - date: "2025-12-01"
    #   description: "Important Event"
    #   impact: "HIGH"
    #   action: "reduce_position"