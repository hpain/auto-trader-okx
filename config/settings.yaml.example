    rf:
      n_estimators_range: [100, 1000]
      max_depth_range: [3, 20]
      min_samples_leaf_range: [1, 10]
    lgb:
      n_estimators_range: [100, 1000]
      num_leaves_range: [20, 150]
      learning_rate_range: [0.01, 0.3]
      max_depth_range: [3, 15]
      min_child_samples_range: [20, 100]

# ==============================================================================
