# OKX API Credentials (Required for Paper/Live Trading)
# For Paper Trading, use credentials from your OKX Demo Trading account.
OKX_API_KEY=your_api_key_here
OKX_SECRET_KEY=your_secret_key_here
OKX_PASSPHRASE=your_passphrase_here

# Trading Mode
# 0 = Paper/Demo Trading (Sandbox)
# 1 = Real/Live Trading
OKX_FLAG=0

# Mock Mode (Internal Simulation)
# Set to 1 to run completely offline with simulated data (no API connection needed)
# Set to 0 or leave empty to use OKX API (Paper or Live)
MOCK_MODE=0
